// ============================================================
// Module: ALU (Arithmetic Logic Unit)
// Function: Performs arithmetic and logic operations for RISC-V.
// Inputs : a, b (operands), alu_control (4-bit control)
// Outputs: result (32-bit), zero (1 if result==0)
// Notes  : Operations: AND=0000, OR=0001, ADD=0010, SUB=0110,
//          SLT=0111 (signed), XOR=0100, SLL=1000, SRL=1001.
//          Synthesis: Pure combinational logic.
// ============================================================

`timescale 1ns/1ps
module alu(
    output reg [31:0] result,    // ALU result
    output zero,                 // Zero flag
    input [3:0] alu_control,     // Control signal
    input [31:0] a, b            // Operands
);
    
    always @(*) begin
        case (alu_control)
            4'b0000: result = a & b;                    // AND
            4'b0001: result = a | b;                    // OR
            4'b0010: result = a + b;                    // ADD
            4'b0110: result = a - b;                    // SUB
            4'b0111: result = ($signed(a) < $signed(b)) ? 32'd1 : 32'd0;  // SLT (signed)
            4'b0100: result = a ^ b;                    // XOR
            4'b1000: result = a << b[4:0];             // SLL (shift left logical)
            4'b1001: result = a >> b[4:0];             // SRL (shift right logical)
            default: result = 32'b0;                    // Default
        endcase
    end
    
    assign zero = (result == 32'b0);
    
endmodule